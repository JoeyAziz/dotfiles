# Font
font-family = JetBrains Mono
font-style = Medium
font-style-bold = Bold
font-style-italic = Medium Italic
font-style-bold-italic = Bold Italic
font-size = 13
font-thicken = true
font-thicken-strength = 100
adjust-cell-height = 15%

# Theme
#theme = Kanagawa Wave
theme = desert
#theme = Black Metal (Khold)

window-padding-x = 8
window-padding-y = 4


# Mac styles
macos-icon-frame = beige
# Make Option key send Alt/Meta for Neovim keybindings
macos-option-as-alt = true
